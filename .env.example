# ============================================
# BLACK WALL - Configuration Environment
# ============================================
# Copiez ce fichier en ".env" et adaptez les valeurs.

# --- Base de données PostgreSQL ---
POSTGRES_USER=blackwall_user
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=blackwall_db
DATABASE_URL=postgresql://blackwall_user:changeme_strong_password@db:5432/blackwall_db

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=info

# --- Frontend ---
BACKEND_API_URL=http://backend:8000

# --- Seuils de détection (Règles statiques) ---
STATIC_THRESHOLD_CONNECTIONS=50
STATIC_THRESHOLD_ALERT_LEVEL=8

# --- Analyse IA (SambaNova DeepSeek) ---
SAMBANOVA_API_KEY=your-sambanova-api-key-here
SAMBANOVA_API_URL=https://api.sambanova.ai/v1/chat/completions
SAMBANOVA_MODEL=DeepSeek-V3.1
AI_ANALYSIS_ENABLED=true

# --- Notifications Email (SMTP) ---
# Pour Gmail : utilisez un "Mot de passe d'application" (pas votre mot de passe normal)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_FROM=your-email@gmail.com
ALERT_EMAIL_TO=admin@example.com
EMAIL_COOLDOWN_SECONDS=300

# --- Surveillance Wazuh ---
# En production Linux : /var/ossec/logs/alerts/alerts.json
# En dev local (Docker) : /app/wazuh_logs/alerts.json
WAZUH_ALERTS_PATH=/app/wazuh_logs/alerts.json
ALERT_MIN_LEVEL=9
CRITICAL_ALERT_LEVEL=12
